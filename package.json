{
  "name": "lif-explorer",
  "version": "2026.8.21",
  "scripts": {
    "dev-server": "babel-node dev-server.js",
    "prerender-server": "cd prerender-server && npm start",
    "postinstall": "(cd client && npm install) && (cd prerender-server && npm install)",
    "dist": "./build.sh",
    "test": "node --require @babel/register --test test/*.test.js",
    "l10n:fetch": "./lang/util/fetch-transifex.sh",
    "l10n:update-strings": "./lang/util/update-strings.sh"
  },
  "author": "Nadav Ivgi",
  "license": "MIT",
  "browserslist": "> 0.5%",
  "lif": {
    "webapp": "./client/src/run-browser.js",
    "x webapp": "./client/index.html",
    "transform": {
      "./client/**/*.js": {"type": "jsx"}
    },
    "web_exports": {
      "/font/": "./www/font/",
      "/img/": "./www/img/",
      "/js/": "./www/js/",
      "/style.css": "./www/style.css",
      "/instascan.min.js": "./www/instascan.min.js",
      "/.index": "./public/.index"
    },
    "dependencies": {
      "lif-explorer": "github:lif-zone/lif-explorer",
      "@babel/plugin-transform-react-jsx": "^7.12.11",
      "@cycle/dom": "^22.8.0",
      "@cycle/history": "^7.4.0",
      "@cycle/html": "^3.4.0",
      "@cycle/http": "^15.4.0",
      "@cycle/rxjs-run": "^10.5.0",
      "@cycle/storage": "^5.1.2",
      "babelify": "^10.0.0",
      "basic-l10n": "^2.0.0",
      "browserify-package-json": "^1.0.1",
      "bs58check": "^2.1.2",
      "bundle-collapser": "^1.4.0",
      "debug": "^4.3.1",
      "envify": "^4.1.0",
      "fmtbtc": "0.0.3",
      "in-browser-language": "^1.0.3",
      "instascan": "github:shesek/instascan#packaged-lib",
      "jquery": "^3.5.1",
      "path-to-regexp": "^6.2.0",
      "qrcode": "^1.4.4",
      "rxjs": "^7.8.1",
      "snabbdom-pragma": "^2.8.0",
      "superagent": "^6.1.0",
      "uglifyify": "^5.0.2"
    },
    "overrides": {
      "has-symbols": "^1.1.0",
      "which-typed-array": "^1.1.22",
      "is-typed-array": "^1.1.15"
    }
  },
  "devDependencies": {
    "@babel/register": "^7.12.10",
    "browserify-middleware": "^8.1.1",
    "express": "^4.17.1",
    "glob": "^7.1.6",
    "morgan": "^1.10.0"
  },
  "dependencies": {
    "@babel/cli": "^7.12.10",
    "@babel/core": "^7.12.10",
    "@babel/node": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "browserify": "^17.0.0",
    "bundle-collapser": "^1.4.0",
    "cssjanus": "^2.0.1",
    "move-decimal-point": "0.0.4",
    "patch-package": "^6.2.2",
    "pofile": "^1.1.0",
    "pug": "^3.0.0",
    "pug-cli": "^1.0.0-alpha6",
    "snabbdom-to-html": "^6.0.0",
    "typeface-inconsolata": "0.0.72",
    "uglify-es": "^3.3.9"
  }
}
